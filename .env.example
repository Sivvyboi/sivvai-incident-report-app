# ==============================================================================
# Citizen Report - Mobile Application & WordPress Environment Configuration
# ==============================================================================
# For Cordova client apps, runtime values are mapped to: www/js/config.js
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WordPress Backend Endpoints
# ------------------------------------------------------------------------------
# Live WordPress Studio Preview URL (active API backend)
WP_API_BASE_URL=https://sivvyboi-yvxpm-studio.wp.build

# Local WordPress Studio instance (fallback / development)
WP_LOCAL_URL=https://sivvai-incident-report.wp.local

# Incident REST API Namespace
WP_API_NAMESPACE=/wp-json/citizen-report/v1

# ------------------------------------------------------------------------------
# 2. Firebase Authentication Credentials
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# ------------------------------------------------------------------------------
# 3. Google OAuth Credentials for Native Mobile App (Android) & Web
# ------------------------------------------------------------------------------
GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
ANDROID_PACKAGE_NAME=com.sivvai.citizenreport
ANDROID_SHA1_FINGERPRINT=AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD

GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
